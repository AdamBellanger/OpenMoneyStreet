# Prospecteur — variables d'environnement.
# Copier vers .env (jamais commité) et remplir. Docker compose le lit via env_file.

# --- Authentification (obligatoire) -------------------------------------------
# Identifiant de l'unique utilisateur.
AUTH_USERNAME=adam

# Hash bcrypt du mot de passe, ENCODÉ EN BASE64 (les "$" d'un hash bcrypt seraient
# interprétés comme des variables par docker compose).
# Générer la ligne (12 caractères minimum) :
#   npm run hash-password
# ou, sur le serveur (sans Node), avec l'image construite par `docker compose build` :
#   docker run --rm -it --entrypoint node prospecteur:latest scripts/hash-password.mjs
AUTH_PASSWORD_HASH_B64=

# Clé de signature des cookies de session (32 caractères minimum).
# La changer déconnecte toutes les sessions. Générer :
#   openssl rand -base64 48
SESSION_SECRET=

# --- Optionnel (valeurs par défaut indiquées) ----------------------------------
# Chemin de la base SQLite (déjà fixé dans l'image Docker).
# DATABASE_PATH=/app/data/prospecteur.db

# User-Agent envoyé à Overpass, Panoramax et aux sites vérifiés.
# PROSPECTEUR_USER_AGENT=Prospecteur/1.0 (contact@adambellanger.pro)

# Instances Overpass, séparées par des virgules : la 2e sert de secours si la 1re est saturée.
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
